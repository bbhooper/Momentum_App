    {
      "name": "daily_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date_key\" TEXT NOT NULL UNIQUE, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"end_day_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"end_day_completed\" IN (0, 1)), \"end_day_completed_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "sleep_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sleep_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"daily_record_id\" INTEGER NOT NULL UNIQUE REFERENCES daily_records (id) ON DELETE CASCADE, \"bedtime\" INTEGER NOT NULL, \"wake_time\" INTEGER NOT NULL, \"sleep_onset_adjustment_minutes\" INTEGER NOT NULL DEFAULT 0, \"sleep_latency_source\" TEXT NOT NULL DEFAULT 'scientificEstimate', \"awakening_count\" INTEGER NOT NULL DEFAULT 0 CHECK(awakening_count >= 0), \"awake_during_night_minutes\" INTEGER NOT NULL DEFAULT 0 CHECK(awake_during_night_minutes >= 0), \"calculated_duration_minutes\" INTEGER NOT NULL, \"manual_duration_minutes\" INTEGER NULL, \"sleep_quality\" INTEGER NOT NULL CHECK(sleep_quality BETWEEN 1 AND 5), \"energy\" INTEGER NOT NULL CHECK(energy BETWEEN 1 AND 5), \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    }
